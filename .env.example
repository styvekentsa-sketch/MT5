# =============================================================================
#  MT5 AI Trading Bot - Variables d'environnement
#  Copier ce fichier en ".env" puis renseigner les valeurs.
#  NE JAMAIS committer le fichier .env !
# =============================================================================

# --- Mode d'exécution ---
# DRY_RUN=true : le bot analyse et logue les signaux SANS envoyer d'ordres.
DRY_RUN=true
# Vide = valeur du profil de stratégie (60 s en standard, 10 s en scalping)
BOT_LOOP_INTERVAL_SECONDS=

# --- Plateforme de trading ---
# mt5  : Forex / métaux / indices via un terminal MetaTrader 5 (MetaQuotes, Exness, IC Markets...)
# ccxt : exchange crypto, contrats perpétuels USDT (Binance USDⓈ-M, Bybit, OKX...)
# sim  : SIMULATION, sans MT5 ni internet (bougies fictives ou CSV locaux, compte virtuel, aucun ordre réel)
BROKER_TYPE=mt5

# --- Simulation (BROKER_TYPE=sim) ---
# Bougies fictives reproductibles (même graine = mêmes bougies)
SIM_SEED=42
SIM_BALANCE=10000
# Facultatif : dossier de bougies locales <SYMBOLE>_<TF>.csv (ex : EURUSD_H1.csv) ou <SYMBOLE>.csv
SIM_DATA_DIR=

# --- MetaTrader 5 (BROKER_TYPE=mt5) ---
# Suffixe ajouté aux symboles par le broker (Exness Standard : m -> EURUSDm). Vide le plus souvent.
MT5_SYMBOL_SUFFIX=
MT5_ACCOUNT=12345678
MT5_PASSWORD=change_me
MT5_SERVER=MetaQuotes-Demo
# Chemin vers terminal64.exe (optionnel, utile si plusieurs terminaux installés)
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT_MS=60000

# --- Exchange crypto (BROKER_TYPE=ccxt) ---
# Identifiant ccxt : binanceusdm (Binance Futures USDⓈ-M), bybit, okx...
CCXT_EXCHANGE=bybit
# demo = compte démo de l'exchange (recommandé pour commencer) | testnet | live
CCXT_ENVIRONMENT=demo
# Sans clé : PAPER uniquement, sur données publiques réelles, avec un capital fictif.
# Clé API : droits « trading » uniquement, JAMAIS « retrait ». Sous-compte dédié au bot conseillé
# (toutes les positions des symboles suivis sont considérées comme celles du bot).
CCXT_API_KEY=
CCXT_API_SECRET=
# Passphrase (OKX, KuCoin...)
CCXT_API_PASSWORD=
CCXT_LEVERAGE=3
CCXT_QUOTE=USDT
CCXT_PAPER_BALANCE=10000
# Symboles crypto : TRADING_SYMBOLS=BTCUSDT,ETHUSDT (notation ccxt BTC/USDT:USDT acceptée)

# --- Trading ---
# Liste séparée par des virgules (noms exacts du broker, ex : EURUSD, XAUUSD, US30.cash)
TRADING_SYMBOLS=EURUSD,GBPUSD,XAUUSD
# M1, M5, M15, M30, H1, H4, D1, W1, MN1
# Vide = valeur du profil de stratégie (M15 en standard, M1 en scalping)
TRADING_TIMEFRAME=
TRADING_BARS_HISTORY=500
TRADING_MAGIC_NUMBER=20261026
TRADING_DEVIATION_POINTS=20

# --- Gestion du risque ---
RISK_PER_TRADE_PCT=1.0
RISK_MAX_DAILY_LOSS_PCT=3.0
# Bouton « Exécuter ce setup en Live » du dashboard : autorisé sur un compte RÉEL (démo seulement par défaut)
RISK_ALLOW_MANUAL_REAL_ACCOUNT=false
# Pertes consécutives du jour (trades du bot) au-delà desquelles on arrête de trader
RISK_MAX_CONSECUTIVE_LOSSES=2
RISK_MAX_OPEN_POSITIONS=2
RISK_MAX_POSITIONS_PER_SYMBOL=1
# Risque cumulé : somme des pertes si TOUS les SL étaient touchés (positions ouvertes + nouveau trade),
# en % du capital. Ex : 5 trades simultanés à 1 % chacun nécessitent RISK_MAX_TOTAL_RISK_PCT=5.
# Garder cette valeur <= RISK_MAX_DAILY_LOSS_PCT : un mouvement brutal ne peut alors pas dépasser la perte journalière.
RISK_MAX_TOTAL_RISK_PCT=2.0
# Marge totale utilisée après un nouveau trade, en % des fonds propres (50 % = niveau de marge >= 200 %)
RISK_MAX_MARGIN_USAGE_PCT=50
# Forex : spread maximal en points ; crypto : en % du prix
RISK_MAX_SPREAD_POINTS=30
RISK_MAX_SPREAD_PCT=0.15
# Vérificateur indépendant (risk/verifier.py), dernier contrôle avant tout ordre ou setup :
# ratio net estimé minimal (gain - spread) / (perte + spread)
RISK_MIN_NET_REWARD_RISK=3.0
# spread maximal en % de la distance entrée - stop, et en multiple de sa médiane sur 60 minutes
RISK_MAX_SPREAD_SL_PCT=10
RISK_MAX_SPREAD_MEDIAN_RATIO=2.0
# Vides = valeurs du profil (standard 1.5 / 3.0 ATR, scalping 1.0 / 1.2 ATR)
RISK_SL_ATR_MULTIPLIER=
RISK_TP_ATR_MULTIPLIER=
# Bornes en lots, appliquées au Forex / CFD uniquement (la crypto suit les limites de l'exchange)
RISK_MIN_LOT=0.01
RISK_MAX_LOT=1.0

# --- Sources d'actualités (API) ---
# https://newsapi.org
NEWSAPI_KEY=
# https://finnhub.io
FINNHUB_API_KEY=
# https://www.alphavantage.co (endpoint NEWS_SENTIMENT)
ALPHAVANTAGE_API_KEY=
# Catalogue intégré de ~17 sources vérifiées : Bloomberg, Reuters (via Google News), WSJ, MarketWatch,
# CNBC, FXStreet, investingLive, FXEmpire, Investing.com, Nasdaq, Fed, BCE, Banque d'Angleterre,
# + un flux Yahoo Finance par symbole tradé. false = uniquement les flux de NEWS_RSS_FEEDS.
NEWS_DEFAULT_FEEDS=true
# Flux RSS supplémentaires (séparés par des virgules), ajoutés au catalogue
NEWS_RSS_FEEDS=
# Équilibrage : nombre maximal d'articles retenus par source (évite qu'une source domine le sentiment)
NEWS_MAX_PER_FEED=15
NEWS_REFRESH_INTERVAL_SECONDS=300
NEWS_LOOKBACK_HOURS=6
# Fenêtre de sécurité : aucune nouvelle proposition de 30 min avant à 15 min après une annonce
# à fort impact sur une devise de l'actif (EURUSD : EUR et USD ; XAUUSD : USD)
NEWS_BLOCK_MINUTES_BEFORE=30
NEWS_BLOCK_MINUTES_AFTER=15
# Calendrier : forexfactory (semaine en cours) | simulated (événements de NEWS_CALENDAR_FILE uniquement)
NEWS_CALENDAR_PROVIDER=forexfactory
# Facultatif : fichier JSON d'annonces ajoutées (résultats réels, tests) :
# [{"time": "2026-11-06T13:30:00Z", "title": "Non-Farm Employment Change", "currency": "USD",
#   "importance": "high", "consensus": "180K", "previous": "150K", "actual": "250K"}]
NEWS_CALENDAR_FILE=
NEWS_REQUEST_TIMEOUT_SECONDS=10

# --- Analyse de sentiment ---
# vader (léger + lexique financier) | keywords (mots-clés financiers, aucune dépendance)
# finbert (transformers) | llm (Claude via API Anthropic, non implémenté : repli sur vader)
SENTIMENT_ENGINE=vader
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Moteur de stratégie ---
# Profil : standard (M15, signaux rares et confirmés) | scalping (M1, indicateurs EMA5/13,
# RSI7, MACD 5/13/4, seuils bas, SL 1 ATR / TP 1.2 ATR, SL d'au moins 3 spreads) | micro (M1,
# aucun seuil : tout signal technique non nul ouvre un trade, sentiment ignoré, SL / TP 5 pips)
# | adaptive (choisit par symbole et à chaque tour : swing si tendance D1/H1 forte, day trading
# aux ouvertures de sessions, scalping en heures liquides sur range serré ; voir ADAPTIVE_*).
# Chaque réglage ci-dessous laissé vide prend la valeur du profil ; renseigné, il la remplace.
# ATTENTION : en backtest sur données réelles, le profil scalping est perdant sur toutes les
# variantes testées (spread élevé par rapport aux objectifs) : à réserver au mode PAPER.
STRATEGY_PROFILE=standard
# Fuseau horaire du serveur MT5 (heure d'été comprise) : les bougies MT5 sont horodatées à l'heure du
# serveur ; ce fuseau les convertit en UTC réel (sessions de liquidité, calendrier en backtest).
# MetaQuotes-Demo : Europe/Athens (UTC+2 l'hiver, UTC+3 l'été). MT5_SERVER_UTC_OFFSET_HOURS impose un décalage fixe.
MT5_SERVER_TIMEZONE=Europe/Athens
# Stratégies à setups (mode analyste, dashboard, backtest) : pullback, range_rejet, momentum_breakout, impulsion, petits_trades
SETUP_STRATEGIES=pullback,range_rejet,momentum_breakout,impulsion,petits_trades
# Breakout momentum : marge de protection b du stop multipliée par actif (fortes mèches en M15) ;
# actifs absents : 1.0 (forex majeur). Le TP est recalculé pour garder un ratio net >= 3.
STRATEGY_MARGIN_MULTIPLIERS=XAUUSD:1.5,XAGUSD:1.5
# Breakout momentum : corps minimal de la bougie de relance, en multiples de l'ATR(5) (moyenne des vraies
# amplitudes des 5 bougies précédentes) ; relance plus faible : setup invalidé. 0 = filtre désactivé
# (défaut : en backtest, le filtre à 0.8 / 1.0 écartait les relances moyennes, celles des trades gagnants)
STRATEGY_MOMENTUM_RESTART_BODY_ATR=0
# Breakout momentum : ratio net visé par le TP (3 par défaut). En dessous de RISK_MIN_NET_REWARD_RISK, le
# vérificateur indépendant refuserait tout : pour tester 2.5, mettre aussi RISK_MIN_NET_REWARD_RISK=2.5
STRATEGY_MOMENTUM_TARGET_RR=3.0
# Breakout momentum : sortie dynamique (backtest, risk/trailing.py), paliers en R de gain latent.
# BREAKEVEN_R : stop ramené au prix d'entrée dès +X R (0 = désactivé)
# TRAILING_ACTIVATION_R : le stop suit le marché dès +X R (0 = désactivé), selon TRAILING_MODE :
#   bars = plus bas des TRAILING_BARS dernières bougies M15, atr = meilleur prix - TRAILING_ATR x ATR,
#   r = meilleur prix - TRAILING_DISTANCE_R x R. Le stop ne recule jamais.
STRATEGY_MOMENTUM_BREAKEVEN_R=0
STRATEGY_MOMENTUM_TRAILING_ACTIVATION_R=0
STRATEGY_MOMENTUM_TRAILING_MODE=bars
STRATEGY_MOMENTUM_TRAILING_BARS=3
STRATEGY_MOMENTUM_TRAILING_ATR=1.5
STRATEGY_MOMENTUM_TRAILING_DISTANCE_R=1.0
# Breakout momentum : filtre de contexte H1 (setup invalidé « Contexte H1 invalide : ... »)
# ADX(14) H1 minimal (marché amorphe en dessous) ; 0 = désactivé
STRATEGY_MOMENTUM_MIN_H1_ADX=22.0
# Obstacle : plus haut (achat) / plus bas (vente) des N dernières bougies H1, non franchi et à moins de
# X ATR H1 de l'entrée ; 0 = désactivé
STRATEGY_MOMENTUM_H1_LOOKBACK=20
STRATEGY_MOMENTUM_H1_OBSTACLE_ATR=1.0
# Tendance de fond : achat interdit si EMA rapide <= EMA lente en H1 (vente : l'inverse)
STRATEGY_MOMENTUM_H1_EMA_ALIGNMENT=true
STRATEGY_MOMENTUM_H1_EMA_FAST=50
STRATEGY_MOMENTUM_H1_EMA_SLOW=200
# --- Impulsion (strategies/impulse.py) : rattrapage d'un mouvement violent et propre ---
# Quand la stratégie principale dit HOLD (marché en expansion, pas de croisement...), le moteur ouvre
# un trade si les IMPULSE_BARS dernières bougies sont fortes (corps >= MIN_BODY_ATR, mèche opposée
# <= MAX_WICK_PCT %) et le mouvement total entre MIN_MOVE_ATR et MAX_MOVE_ATR ATR. SL obligatoire :
# entrée -/+ SL_ATR x ATR récent ; TP au ratio net RISK_MIN_NET_REWARD_RISK ; 1 % de risque.
IMPULSE_ENABLED=false
IMPULSE_TIMEFRAME=M15
IMPULSE_BARS=3
IMPULSE_MIN_BODY_ATR=0.4
IMPULSE_MAX_WICK_PCT=35
IMPULSE_MIN_MOVE_ATR=1.5
IMPULSE_MAX_MOVE_ATR=4.0
IMPULSE_SL_ATR=1.5
# Uniquement en session de liquidité (Londres 07:00-10:00, New York 12:30-16:00 UTC)
IMPULSE_SESSION_ONLY=true
# --- Petits trades / micro-scalping (strategies/micro_scalp.py) ---
# Quand la stratégie principale dit HOLD (et après l'impulsion), le moteur ouvre de petits trades M5 en session
# Londres / New York : micro-cassure d'une consolidation ou petit rebond sur l'EMA 20, dans le sens de la
# micro-tendance M15. SL = SL_ATR x ATR, TP au ratio net TP_R : le vérificateur exige CE ratio pour ce mode
# (les autres stratégies restent à RISK_MIN_NET_REWARD_RISK). 1 % de risque, positions max et perte journalière
# inchangés. Ordres « Bot PETIT BUY/SELL », journal : stratégie « petits_trades ».
STRATEGY_SCALP_ENABLED=false
STRATEGY_SCALP_TP_R=1.2
STRATEGY_SCALP_SL_ATR=1.0
STRATEGY_SCALP_TIMEFRAME=M5
STRATEGY_SCALP_RANGE_BARS=12
STRATEGY_SCALP_MAX_RANGE_ATR=2.0
# Corrélation : risque cumulé maximal exposé à une même devise dans le même sens, en % du capital
# (EURUSD achat + XAUUSD achat = deux positions vendeuses de USD). Entre RISK_PER_TRADE_PCT et RISK_MAX_TOTAL_RISK_PCT.
RISK_MAX_CURRENCY_RISK_PCT=1.5
# Suspension des nouvelles entrées quand les fonds propres reculent de X % depuis leur plus haut (0 = désactivé)
RISK_MAX_DRAWDOWN_PCT=10

# Sorties partielles : EXIT_TP1_FRACTION du volume fermé à EXIT_TP1_R, puis EXIT_TP2_FRACTION à EXIT_TP2_R,
# le reste vise le TP de l'ordre (TP3). 0 = TP unique. Le passage au prix d'entrée après le TP1 ne garantit
# pas une sortie sans perte (frais, glissement, gap).
EXIT_TP1_R=1.0
EXIT_TP1_FRACTION=0
EXIT_TP2_R=2.0
EXIT_TP2_FRACTION=0
EXIT_BREAKEVEN_AFTER_TP1=true
# Mode Bouclier, avant une annonce à fort impact (fenêtre NEWS_BLOCK_MINUTES_BEFORE) sur les positions exposées :
# none, breakeven (stop au prix d'entrée si la position est en gain), reduce (SHIELD_REDUCE_FRACTION fermée), close
SHIELD_ACTION=none
SHIELD_REDUCE_FRACTION=0.5
# Après publication : fermer une position dont le scénario est invalidé (effet >= SHIELD_CONTRARY_STRENGTH à contre-sens)
SHIELD_CLOSE_CONTRARY=true
SHIELD_CONTRARY_STRENGTH=0.66

# Analyse descendante (strategies/top_down.py), trade d'opportunité tenté EN PREMIER quand la stratégie principale
# dit HOLD : direction W1 (règle des 3 bougies), support / résistance D1 (TOPDOWN_MIN_TOUCHES touches), zone de
# demande / d'offre H4 MAJEURE posée dessus, entrée raffinée H1 -> M30 -> M15 (-> M5 pour TOPDOWN_FINE_SYMBOLS)
# jusqu'à un stop <= TOPDOWN_MAX_SL_ATR ATR H4 ; objectif 3 R refusé si une résistance / un support D1 le bloque.
TOPDOWN_ENABLED=false
TOPDOWN_MAX_SL_ATR=1.0
TOPDOWN_MIN_TOUCHES=3
TOPDOWN_FINE_SYMBOLS=XAU,XAG,BTC,ETH,US30,NAS,US100,USTEC,SPX,US500,GER,DE40

# Protection automatique de chaque position du robot (core/position_protection.py), R = distance entre le prix
# réel d'entrée et le stop initial, figée à l'ouverture et sauvegardée (data/position_protection.json) :
#   +PROTECT_BREAKEVEN_R      : stop au prix d'entrée + marge de frais (commission convertie + marge en points)
#   +PROTECT_TRAILING_START_R : stop suiveur à PROTECT_TRAILING_DISTANCE_R du meilleur Bid (achat) / Ask (vente)
# Le stop ne recule jamais et ne bouge que s'il progresse d'au moins PROTECT_MIN_STEP_R ; arrondi au tick,
# distance minimale et zone de gel du courtier respectées. Le TP de l'ordre est conservé ; une position sans
# TP reçoit PROTECT_TAKE_PROFIT_R (0 = aucun). Refus du courtier journalisé, nouvel essai après PROTECT_RETRY_SECONDS.
PROTECT_ENABLED=true
PROTECT_BREAKEVEN_R=1.0
PROTECT_BREAKEVEN_MARGIN_POINTS=0
PROTECT_COMMISSION_PER_LOT=0
PROTECT_TRAILING_START_R=1.5
PROTECT_TRAILING_DISTANCE_R=1.0
PROTECT_MIN_STEP_R=0.1
PROTECT_TAKE_PROFIT_R=3.0
PROTECT_RETRY_SECONDS=30

# Symboles autorisés pour les trades d'opportunité (impulsion, petits trades) ; vide = tous les TRADING_SYMBOLS.
# Les autres symboles restent suivis par la stratégie principale uniquement.
OPPORTUNITY_SYMBOLS=
# Pondération technique vs sentiment (la somme doit faire 1.0)
STRATEGY_TECHNICAL_WEIGHT=
STRATEGY_SENTIMENT_WEIGHT=
# Score combiné minimal (0..1) pour ouvrir une position
STRATEGY_SIGNAL_THRESHOLD=
# Score technique minimal (0..1) pour qu'un signal BUY / SELL existe
STRATEGY_TECHNICAL_THRESHOLD=
# Distance minimale du SL en multiples du spread (0 = aucune)
STRATEGY_MIN_SL_SPREADS=
# true : SL élargi jusqu'au dernier plus bas / plus haut (si proche)
STRATEGY_STRUCTURAL_SL=
# SL / TP fixes en pips, à la place de l'ATR (0 = ATR). 1 pip = 0.0001 EURUSD, 0.01 USDJPY, 0.1 XAUUSD
STRATEGY_SL_PIPS=
STRATEGY_TP_PIPS=

# --- Mémoire des erreurs (journal des trades, post-mortem des pertes, patterns bloqués) ---
# Fichiers : trade_decisions.json, loss_analysis.json, mistakes_memory.json (un dossier par compte en multi-comptes)
LEARNING_ENABLED=true
LEARNING_DIR=data/learning
# Un pattern de marché bloque les ordres similaires après N pertes et X % de trades perdants...
MISTAKE_MIN_LOSSES=2
MISTAKE_MIN_LOSS_RATE=0.6
# ... et est oublié après N jours sans nouvelle perte
MISTAKE_MEMORY_DAYS=30

# --- Profil adaptive : fenêtres horaires (UTC) ---
# Ouvertures de sessions (Londres, New York) : mode day trading
ADAPTIVE_DAY_WINDOWS=07:00-10:00,12:30-15:30
# Heures liquides : mode scalping possible (si le range M5 est serré)
ADAPTIVE_LIQUID_HOURS=07:00-20:00
# Fermeture obligatoire des positions day trading (aucun portage de nuit)
ADAPTIVE_DAY_CLOSE=20:30

# --- Logs ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10

# --- API du dashboard (FastAPI) ---
API_ENABLED=true
# 127.0.0.1 = accessible uniquement depuis cette machine (recommandé)
API_HOST=127.0.0.1
API_PORT=8000
# Clé exigée dans l'en-tête X-API-Key (16 caractères minimum)
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Origines autorisées (dashboard React / Vite), séparées par des virgules.
# Accès depuis un téléphone du réseau local : API_HOST=0.0.0.0 et ajouter http://<IP-du-PC>:5173
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Webhooks entrants (TradingView...) : journalisés, JAMAIS exécutés automatiquement ---
# Secret propre aux webhooks (16 caractères min., différent d'API_KEY), vide = désactivé.
# URL à saisir dans TradingView : https://<hôte-public>/api/webhooks/tradingview?token=<WEBHOOK_SECRET>
# (TradingView n'envoie qu'aux ports 80/443 : exposer l'API derrière un reverse proxy HTTPS)
WEBHOOK_SECRET=http://localhost:8000/api/webhooks/tradingview?token=<WEBHOOK_SECRET>

# --- Notifications (Telegram et/ou Discord) : laisser vide pour désactiver ---
# Telegram : créer un bot avec @BotFather (token), puis obtenir le chat_id
# (envoyer un message au bot, puis ouvrir https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord : Paramètres du salon > Intégrations > Webhooks > Copier l'URL
DISCORD_WEBHOOK_URL=
# Une même alerte répétée (ex : trade bloqué) n'est pas renvoyée avant ce délai
NOTIFY_COOLDOWN_SECONDS=900
NOTIFY_TIMEOUT_SECONDS=10
# Alertes aussi affichées dans la console du bot (setups validés, pertes, blocages)
NOTIFY_CONSOLE=false

# --- Historique (SQLite) : webhooks, articles analysés, décisions du moteur ---
DB_PATH=data/trading_bot.db
# Historique plus ancien supprimé au démarrage du bot
DB_RETENTION_DAYS=90

# --- Multi-comptes / multi-plateformes (facultatif) : un processus bot par compte ---
# Laisser vide = compte unique (MT5_ACCOUNT / MT5_PASSWORD / MT5_SERVER ci-dessus).
# Chaque compte a besoin de SON terminal : copier le dossier d'installation de MT5
# (ex : D:\MT5 App -> D:\MT5 App 2), le lancer et s'y connecter une fois au compte.
# Toute variable ACCOUNT_<ID>_<NOM> remplace <NOM> pour ce compte (risque, symboles, DRY_RUN...).
MT5_ACCOUNTS=
# ACCOUNT_MAIN_LOGIN=12345678
# ACCOUNT_MAIN_PASSWORD=change_me
# ACCOUNT_MAIN_SERVER=MetaQuotes-Demo
# ACCOUNT_MAIN_PATH=D:\MT5 App\terminal64.exe
# ACCOUNT_MAIN_LABEL=Principal
# ACCOUNT_TEST_LOGIN=87654321
# ACCOUNT_TEST_PASSWORD=change_me
# ACCOUNT_TEST_SERVER=MetaQuotes-Demo
# ACCOUNT_TEST_PATH=D:\MT5 App 2\terminal64.exe
# ACCOUNT_TEST_LABEL=Test
# ACCOUNT_TEST_RISK_PER_TRADE_PCT=0.5
# ACCOUNT_TEST_DRY_RUN=true
# Compte Exness (MT5) : symboles suffixés
# ACCOUNT_EXNESS_SYMBOL_SUFFIX=m
# Compte crypto (ccxt) : pas de terminal, identifiants de l'exchange
# ACCOUNT_BYBIT_BROKER=ccxt
# ACCOUNT_BYBIT_EXCHANGE=bybit
# ACCOUNT_BYBIT_ENVIRONMENT=demo
# ACCOUNT_BYBIT_API_KEY=
# ACCOUNT_BYBIT_API_SECRET=
# ACCOUNT_BYBIT_LEVERAGE=3
# ACCOUNT_BYBIT_TRADING_SYMBOLS=BTCUSDT,ETHUSDT
# ACCOUNT_BYBIT_LABEL=Bybit
